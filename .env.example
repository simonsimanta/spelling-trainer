APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
VITE_PORT=5173
DATABASE_URL=sqlite:///./data/spelling.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For Supabase, copy the Session pooler URI from Dashboard > Connect.
# A persistent local FastAPI process should normally use the Session pooler on port 5432.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Restore the SQLite line above to switch back to local-only storage.
# VITE_API_BASE_URL=http://127.0.0.1:8000
